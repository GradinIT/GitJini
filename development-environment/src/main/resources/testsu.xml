<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns:os-core="http://www.openspaces.org/schema/core"
       xmlns:os-remoting="http://www.openspaces.org/schema/remoting"
       xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd
       http://www.openspaces.org/schema/core http://www.openspaces.org/schema/16.4/core/openspaces-core.xsd
       http://www.openspaces.org/schema/remoting http://www.openspaces.org/schema/16.4/remoting/openspaces-remoting.xsd">

    <!-- A space -->
    <os-core:space id="space" url="/./testSpace" />

    <!-- A space proxy -->
    <os-core:giga-space id="gigaSpace" space="space" />

    <!-- A remoting service -->
    <os-remoting:service-exporter id="serviceExporter">
        <os-remoting:service ref="myService" />
    </os-remoting:service-exporter>

    <bean id="myService" class="net.jini.example.HelloServiceImpl">
        <constructor-arg value="test-su-service" />
    </bean>

</beans>
